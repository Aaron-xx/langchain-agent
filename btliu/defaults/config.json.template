{
    "log_level": "WARNING",
    "environment_type": "external",
    "postgresql_uri": "postgresql://langchain:langchain_postgres@postgres:5432/langchain",
    "models": {
        "chat": {
            "openai": {
                "provider": "openai",
                "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
                "model": "glm-4.5",
                "temperature": 0.7,
                "max_tokens": 2048,
                "api_key": "${OPENAI_API_KEY:-}",
            },
            "ollama": {
                "provider": "ollama",
                "base_url": "http://ollama:11434",
                "model": "qwen3:8b",
                "temperature": 0.7,
            },
        },
        "embedding": {
            "openai": {
                "provider": "openai",
                "base_url": "https://open.bigmodel.cn/api/coding/paas/v4",
                "model": "text-embedding-3-small",
                "api_key": "${OPENAI_API_KEY:-}",
            },
            "ollama": {
                "provider": "ollama",
                "base_url": "http://ollama:11434",
                "model": "bge-m3:latest",
            },
        },
    },
    "vector_store": {
        "qdrant_url": "http://qdrant:6333",
        "collection_name": "rag_documents",
        "similarity_threshold": 0.60,
    },
    "document_processing": {
        "chunk_size": 1000,
        "chunk_overlap": 200,
    },
    "retrieval": {
        "default_k": 8,
    },
    "mcp_servers": {
        "ucagent": {
            "transport": "streamable_http",
            "url": "http://localhost:5000/mcp",
            "timeout": 30,
        }
    },
    "document_monitor": {
        "enabled": true,
        "debounce_time": 2.0,
        "batch_size": 10,
        "max_retries": 3,
        "log_events": true,
        "ignore_patterns": [
        "*.tmp",
        "*.swp",
        "~*",
        ".DS_Store",
        "*.bak"
        ]
    }
}
