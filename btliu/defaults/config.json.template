{
  "log_level": "WARNING",
  "environment_type": "external",
  "models": {
    "chat": {
      "openai": {
        "provider": "openai",
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "model": "glm-4.5",
        "temperature": 0.7,
        "max_tokens": 2048,
        "api_key": "${OPENAI_API_KEY:-}"
      },
      "ollama": {
        "provider": "ollama",
        "base_url": "http://ollama:11434",
        "model": "qwen3:8b",
        "temperature": 0.7
      }
    },
    "embedding": {
      "openai": {
        "provider": "openai",
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "model": "text-embedding-3-small",
        "api_key": "${OPENAI_API_KEY:-}"
      },
      "ollama": {
        "provider": "ollama",
        "base_url": "http://ollama:11434",
        "model": "bge-m3:latest"
      }
    }
  },
  "vector_store": {
    "qdrant_url": "http://qdrant:6333",
    "collection_name": "rag_documents",
    "similarity_threshold": 0.78,
    "max_retrieved_docs": 4,
    "enable_caching": true,
    "cache_ttl": 3600
  },
  "document_processing": {
    "data_dir": "~/.btliu/data/documents",
    "chunk_size": 1000,
    "chunk_overlap": 200,
    "enable_smart_index": true,
    "hash_index_file": "~/.btliu/data/.hash_index.json"
  },
  "retrieval": {
    "default_k": 5,
    "compression_threshold": 0.7,
    "multi_query_enabled": true,
    "cache_enabled": true,
    "cache_ttl": 3600
  },
  "mcp_servers": {
    "ucagent": {
      "transport": "streamable_http",
      "url": "http://localhost:5000/mcp",
      "timeout": 30
    }
  },
  "document_monitor": {
    "enabled": true,
    "debounce_time": 2.0,
    "batch_size": 10,
    "max_retries": 3,
    "log_events": true,
    "ignore_patterns": [
      "*.tmp",
      "*.swp",
      "~*",
      ".DS_Store",
      "*.bak"
    ]
  }
}