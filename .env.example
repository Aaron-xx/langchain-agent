# =============================================================================
# LangChain Knowledge Base - 环境配置示例
# =============================================================================

# 运行环境 (development, testing, staging, production)
ENVIRONMENT=development
DEBUG=true

# =============================================================================
# 数据库配置
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langchain
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/langchain
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true
DATABASE_ECHO=false

# =============================================================================
# Redis配置
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_RETRY_ON_TIMEOUT=true
REDIS_SOCKET_TIMEOUT=30
REDIS_SOCKET_CONNECT_TIMEOUT=30

# =============================================================================
# LLM配置
# =============================================================================
LLM_DEFAULT_PROVIDER=ollama

# OpenAI配置
LLM_OPENAI_API_KEY=your-openai-api-key-here
LLM_OPENAI_MODEL=gpt-3.5-turbo
LLM_OPENAI_BASE_URL=
LLM_OPENAI_TEMPERATURE=0.7

# Anthropic配置
LLM_ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_ANTHROPIC_MODEL=claude-3-sonnet-20240229
LLM_ANTHROPIC_TEMPERATURE=0.7

# Ollama配置
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_OLLAMA_MODEL=deepseek-coder:6.7b
LLM_OLLAMA_TEMPERATURE=0.7

# Azure OpenAI配置
LLM_AZURE_ENDPOINT=https://your-resource.openai.azure.com/
LLM_AZURE_API_KEY=your-azure-api-key-here
LLM_AZURE_API_VERSION=2023-12-01-preview
LLM_AZURE_DEPLOYMENT_NAME=gpt-35-turbo

#智谱AI配置
LLM_ZHIPUAI_API_KEY=24d433d791d74f989b96917ebea8889d.rfrrFGE9FRAFUMMx
LLM_ZHIPUAI_MODEL=glm4.6
LLM_ZHIPUAI_TEMPERATURE=0.7

# =============================================================================
# 嵌入模型配置
# =============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=m3e-base
EMBEDDING_DIMENSION=768
EMBEDDING_CHUNK_SIZE=1000
EMBEDDING_CHUNK_OVERLAP=200

# =============================================================================
# API配置
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=false
API_LOG_LEVEL=INFO
API_CORS_ORIGINS=["*"]
API_MAX_REQUEST_SIZE=52428800
API_REQUEST_TIMEOUT=300

# =============================================================================
# 安全配置
# =============================================================================
SECURITY_SECRET_KEY=your-super-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7
SECURITY_PASSWORD_MIN_LENGTH=8

# =============================================================================
# 文件配置
# =============================================================================
FILE_UPLOAD_DIR=./data/uploads
FILE_TEMP_DIR=./data/temp
FILE_MAX_FILE_SIZE=52428800
FILE_ALLOWED_EXTENSIONS=["txt", "pdf", "docx", "md", "html", "json"]
FILE_AUTO_CLEANUP_TEMP=true
FILE_CLEANUP_INTERVAL_HOURS=24

# =============================================================================
# 监控配置
# =============================================================================
MONITORING_ENABLE_METRICS=false
MONITORING_METRICS_PORT=9090
MONITORING_ENABLE_TRACING=false
MONITORING_JAEGER_ENDPOINT=
MONITORING_LOG_FORMAT=json

# =============================================================================
# 开发环境专用配置
# =============================================================================
# 在开发环境中启用详细日志
# DATABASE_ECHO=true
# API_RELOAD=true
# DEBUG=true

# =============================================================================
# 生产环境专用配置
# =============================================================================
# ENVIRONMENT=production
# DEBUG=false
# DATABASE_ECHO=false
# DATABASE_POOL_SIZE=50
# DATABASE_MAX_OVERFLOW=100
# API_WORKERS=4
# MONITORING_ENABLE_METRICS=true
# MONITORING_ENABLE_TRACING=true